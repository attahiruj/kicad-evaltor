# Normalise to LF in the repository and keep LF in the working tree.
# Without this, git's autocrlf on Windows rewrites LF to CRLF on checkout and
# the `mixed-line-ending` pre-commit hook reverts it on every commit.
* text=auto eol=lf

# Generated by tools/calibrate_stroke_font.py from a KiCad rendering.
src/kicad_evaltor/_stroke_font_data.json linguist-generated=true -diff

# Generated by tools/calibrate_text_placement.py from a KiCad rendering.
src/kicad_evaltor/_text_placement_data.json linguist-generated=true -diff

# Lock files are large, machine-written and never hand-edited.
uv.lock linguist-generated=true -diff

# Nothing here is binary, but these would be expensive to mangle if they were.
*.png binary
*.pdf binary
*.whl binary
*.zip binary
